APP_NAME=Trading Automation Platform
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_LOG_LEVEL=INFO

MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDER=binance
MARKET_DATA_SYMBOL=BTCUSDT
MARKET_DATA_WEBSOCKET_URL=wss://stream.binance.com:9443/ws
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
MARKET_DATA_RECONNECT_DELAY_SECONDS=2
MARKET_DATA_INCLUDE_RAW_PAYLOAD=false

SIMULATION_ENABLED=true
SIMULATION_BASE_CURRENCY=USD
PAPER_INITIAL_BALANCE=10000.00
SIMULATION_FEE_BPS=10
SIMULATION_SLIPPAGE_BPS=5

BOT_RUNNER_ENABLED=true
BOT_RUNNER_POLL_INTERVAL_SECONDS=2
BINANCE_TESTNET_BROKER_ENABLED=false
BINANCE_TESTNET_ORDER_SUBMISSION_ENABLED=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_TESTNET_TIMEOUT_SECONDS=5
BINANCE_TESTNET_RECV_WINDOW=5000
BINANCE_TESTNET_EXCHANGE_INFO_TTL_SECONDS=300
BINANCE_TESTNET_DRY_RUN_ENABLED=true
BINANCE_TESTNET_RECONCILIATION_INITIAL_DELAY_SECONDS=300
BINANCE_TESTNET_RECONCILIATION_LEASE_SECONDS=60
BINANCE_TESTNET_RECONCILIATION_RETRY_DELAY_SECONDS=300
BINANCE_TESTNET_RECONCILIATION_MAX_AUTOMATIC_ATTEMPTS=5
BINANCE_TESTNET_RECONCILIATION_BATCH_SIZE=10
EXECUTION_GLOBAL_ENABLED=true
EXECUTION_LIVE_ENABLED=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
